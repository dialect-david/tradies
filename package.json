  "dependencies": {
    "phaser": "^4.2.1",
    "vite": "^8.3.2"
  },
  "devDependencies": {
    "@types/node": "^24",
    "prettier": "^3",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
