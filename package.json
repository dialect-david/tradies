{
  "name": "@stottula/tradies",
  "version": "0.4.3",
  "description": "Your beads issues and GitHub pull requests as a construction site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dialect-david/tradies.git"
  },
  "type": "module",
  "bin": {
    "tradies": "bin/tradies.mjs"
  },
  "files": [
